local function removeESP(p)
    local objects = ESPObjects[p]
    if objects then
        for _, obj in ipairs(objects) do
            if obj and obj.Parent then
                obj:Destroy()
            end
        end
    end
    ESPObjects[p] = nil
end

local function createESP(p)
    if p == LP or not p.Character then return end

    removeESP(p)

    local char = p.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not root or not hum or hum.Health <= 0 then return end

    local objects = {}
    ESPObjects[p] = objects

    if S.ESPOn then
        local h = Instance.new("Highlight")
        h.Name = "GOH_GALAXY_ESP"
        h.FillColor = C.Purple
        h.OutlineColor = C.Pink
        h.FillTransparency = 0.65
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = char
        table.insert(objects, h)
    end

    if S.NamesOn or S.DistanceOn then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GOH_GALAXY_INFO"
        billboard.Size = UDim2.fromOffset(170, 35)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = root
        billboard.Parent = PG

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = C.White
        label.TextStrokeTransparency = 0.2
        label.Font = Enum.Font.GothamBold
        label.TextSize = 11
        label.Parent = billboard

        table.insert(objects, billboard)

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not billboard.Parent or not root.Parent then
                connection:Disconnect()
                return
            end

            local text = ""

            if S.NamesOn then
                text = p.DisplayName
            end

            if S.DistanceOn then
                local myRoot = LP.Character
                    and LP.Character:FindFirstChild("HumanoidRootPart")

                if myRoot then
                    local dist = math.floor(
                        (myRoot.Position - root.Position).Magnitude
                    )

                    if text ~= "" then
                        text = text .. " • "
                    end

                    text = text .. dist .. " studs"
                end
            end

            label.Text = text
            billboard.Enabled = S.NamesOn or S.DistanceOn
        end)

        table.insert(objects, connection)
    end
end

