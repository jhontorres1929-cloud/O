    local dot = create("Frame", {
        Size = UDim2.fromOffset(17, 17),
        Position = initial and UDim2.fromOffset(26, 3) or UDim2.fromOffset(3, 3),
        BackgroundColor3 = C.White,
        ZIndex = 7
    }, b)

    corner(dot, 20)

    local enabled = initial

    local function set(value)
        enabled = value

        tween(b, {
            BackgroundColor3 = value and C.Purple
                or Color3.fromRGB(65, 60, 80)
        })

        tween(dot, {
            Position = value and UDim2.fromOffset(26, 3)
                or UDim2.fromOffset(3, 3)
        })

        callback(value)
    end

    connect(b.MouseButton1Click, function()
        set(not enabled)
    end)

    return set
end

-- DESLIZADORES
local function slider(parent, title, min, max, default, callback)
    local f = makeCard(parent, title, "DESLIZA PARA CAMBIAR EL VALOR", 68)

    local valueText = create("TextLabel", {
        Size = UDim2.fromOffset(45, 20),
        Position = UDim2.new(1, -53, 0, 5),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = C.Pink,
        Font = Enum.Font.GothamBlack,
        TextSize = 12,
        ZIndex = 6
    }, f)

    local bar = create("Frame", {
        Size = UDim2.new(1, -22, 0, 7),
        Position = UDim2.fromOffset(11, 48),
        BackgroundColor3 = Color3.fromRGB(65, 55, 80),
        ZIndex = 6
    }, f)

    corner(bar, 10)

    local fill = create("Frame", {
        Size = UDim2.new((default-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = C.Purple,
        ZIndex = 7
    }, bar)

    corner(fill, 10)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(15, 15),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((default-min)/(max-min), 0, 0.5, 0),
        BackgroundColor3 = C.White,
        ZIndex = 8
    }, bar)

    corner(knob, 10)

    local dragging = false

    local function setValue(x)
        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0, 1
        )

        local value = math.floor(min + percent * (max-min) + 0.5)

        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, 0, 0.5, 0)
        valueText.Text = tostring(value)

        callback(value)
    end

    connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setValue(input.Position.X)
        end
    end)

    connect(UIS.InputChanged, function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setValue(input.Position.X)
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

